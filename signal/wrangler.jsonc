// anruf.org Verbindungsserver (Signaling) als Cloudflare Worker + Durable Object.
// Deploy: npx wrangler@4 deploy   ·   Lokal: npx wrangler@4 dev
{
  "name": "anruf-signal",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  // Keine Request-Logs (enthielten IP-Adressen)
  "observability": { "enabled": false }
}
